{
  "name": "resolution-capsule",
  "displayName": "Resolution Capsule",
  "description": "Turn debugging context into sanitized, reviewable public knowledge drafts.",
  "version": "0.1.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:resolutionCapsule.createFromSelection",
    "onCommand:resolutionCapsule.createFromPrompts"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "resolutionCapsule.createFromSelection",
        "title": "Resolution Capsule: Create From Selection"
      },
      {
        "command": "resolutionCapsule.createFromPrompts",
        "title": "Resolution Capsule: Create From Prompts"
      }
    ],
    "configuration": {
      "title": "Resolution Capsule",
      "properties": {
        "resolutionCapsule.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python executable used to run the local capsule engine."
        },
        "resolutionCapsule.sanitizationMode": {
          "type": "string",
          "enum": ["balanced", "strict"],
          "default": "balanced",
          "description": "Default sanitizer mode."
        },
        "resolutionCapsule.enginePath": {
          "type": "string",
          "default": "",
          "description": "Optional path to capsule_cli.py. Leave empty to auto-detect from the workspace or extension folder."
        }
      }
    }
  }
}
